{
  "name": "illustrator-mcp",
  "version": "0.4.0",
  "description": "Zero-CLI Adobe Illustrator CEP Plugin + Live Cloudflare Worker MCP Server for Gemini Enterprise",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "illustrator-mcp": "./dist/index.js",
    "illustrator-mcp-http": "./dist/http-server.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-server.ts",
    "deploy:cf": "wrangler deploy --config cloudflare-worker/wrangler.jsonc",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wrangler": "^4.10.0"
  }
}
