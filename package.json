{
  "name": "illustrator-mcp",
  "version": "0.3.0",
  "description": "Pro Vector MCP Server & CEP Plugin for Adobe Illustrator (16 Tools: Bezier Pen, Pathfinder, Gradients, Masks, SVG, StreamableHTTP + WS)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "illustrator-mcp": "./dist/index.js",
    "illustrator-mcp-http": "./dist/http-server.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini-enterprise",
    "illustrator",
    "cep-extension",
    "extendscript",
    "pathfinder",
    "bezier",
    "streamable-http",
    "websocket",
    "windows"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^4.21.2",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
